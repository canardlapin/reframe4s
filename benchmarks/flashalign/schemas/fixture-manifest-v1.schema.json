{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canardlapin.github.io/reframe4s/flashalign/fixture-manifest-v1.schema.json",
  "title": "Flashalign fixture manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "status",
    "prd",
    "generator",
    "fixture",
    "provenance",
    "holdout_policy",
    "gates",
    "failure_accounting"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schema_version": { "const": "1.0.0" },
    "manifest_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["development-open", "selection-frozen", "audit-sealed"] },
    "prd": { "$ref": "#/$defs/hashedArtifact" },
    "generator": {
      "allOf": [
        { "$ref": "#/$defs/hashedArtifact" },
        {
          "type": "object",
          "required": ["generator_version", "independence_contract"],
          "properties": {
            "generator_version": { "type": "string", "minLength": 1 },
            "independence_contract": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "fixture": { "$ref": "#/$defs/hashedArtifact" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "license", "inputs"],
      "properties": {
        "kind": { "enum": ["analytic-synthetic", "public-dataset", "private-dataset"] },
        "license": { "type": "string", "minLength": 1 },
        "inputs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "holdout_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "development", "selection", "audit", "leakage_rule"],
      "properties": {
        "unit": { "enum": ["fixture-family", "subject", "site"] },
        "development": { "type": "array", "items": { "type": "string" } },
        "selection": { "type": "array", "items": { "type": "string" } },
        "audit": { "type": "array", "items": { "type": "string" } },
        "leakage_rule": { "type": "string", "minLength": 1 }
      }
    },
    "gates": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/gate" }
    },
    "failure_accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["denominator", "required_statuses", "raw_record_schema"],
      "properties": {
        "denominator": { "type": "string", "minLength": 1 },
        "required_statuses": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "raw_record_schema": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "hashedArtifact": {
      "type": "object",
      "additionalProperties": true,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["estimand", "threshold", "evidence"],
      "properties": {
        "estimand": { "type": "string", "minLength": 1 },
        "threshold": {},
        "evidence": { "type": "string", "minLength": 1 }
      }
    }
  }
}
