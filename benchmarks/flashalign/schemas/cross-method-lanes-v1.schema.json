{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canardlapin.github.io/reframe4s/flashalign/cross-method-lanes-v1.schema.json",
  "title": "Flashalign controlled cross-method lanes v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "status", "candidate", "court", "lanes", "scoring", "cost_accounting", "failure_accounting"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schema_version": { "const": "1.0.0" },
    "manifest_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["development-open", "selection-frozen", "audit-sealed"] },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_head", "flashalign_source_tree_sha256", "implementation_prd_sha256"],
      "properties": {
        "repository_head": { "type": "string", "minLength": 7 },
        "flashalign_source_tree_sha256": { "$ref": "#/$defs/sha256" },
        "implementation_prd_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "court": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_rows_per_pair", "shared_input_loads_per_pair", "common_initialization_contract", "heldout_policy"],
      "properties": {
        "expected_rows_per_pair": { "const": 8 },
        "shared_input_loads_per_pair": { "const": 1 },
        "common_initialization_contract": { "type": "string", "minLength": 1 },
        "heldout_policy": { "type": "string", "minLength": 1 }
      }
    },
    "lanes": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/lane" }
    },
    "scoring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "secondary", "candidate_loss_is_ground_truth", "mask_policy_recorded", "model_freedom_recorded"],
      "properties": {
        "primary": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "secondary": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "candidate_loss_is_ground_truth": { "const": false },
        "mask_policy_recorded": { "const": true },
        "model_freedom_recorded": { "const": true }
      }
    },
    "cost_accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cold_standalone", "shared_preparation", "stage_costs", "complete_pipeline"],
      "properties": {
        "cold_standalone": { "type": "string", "minLength": 1 },
        "shared_preparation": { "type": "string", "minLength": 1 },
        "stage_costs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "complete_pipeline": { "type": "string", "minLength": 1 }
      }
    },
    "failure_accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unavailable_lanes_are_rows", "failed_lanes_are_rows", "denominator"],
      "properties": {
        "unavailable_lanes_are_rows": { "const": true },
        "failed_lanes_are_rows": { "const": true },
        "denominator": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "lane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "question", "method_id", "model", "map_interpretation", "configuration_sha256", "objective_id", "support_policy_id", "mask_policy_id", "model_freedom_id", "initialization_source_id", "recipient_controls_sha256", "availability"],
      "properties": {
        "id": { "enum": ["C0", "C1", "C2", "C3", "C4", "C5", "C6", "C7"] },
        "question": { "type": "string", "minLength": 1 },
        "method_id": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "map_interpretation": { "enum": ["complete-moving-to-fixed", "residual-after-supplied-affine"] },
        "configuration_sha256": { "$ref": "#/$defs/sha256" },
        "objective_id": { "type": "string", "minLength": 1 },
        "support_policy_id": { "type": "string", "minLength": 1 },
        "mask_policy_id": { "type": "string", "minLength": 1 },
        "model_freedom_id": { "type": "string", "minLength": 1 },
        "initialization_source_id": { "type": "string", "minLength": 1 },
        "recipient_controls_sha256": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }] },
        "availability": { "enum": ["available", "unavailable-pending-adapter", "conditional"] }
      }
    }
  }
}
