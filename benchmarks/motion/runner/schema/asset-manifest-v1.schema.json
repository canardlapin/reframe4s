{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/canardlapin/reframe4s/benchmarks/motion/asset-manifest-v1.schema.json",
  "title": "reframe4s motion benchmark asset manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "protocolSha256",
    "assets"
  ],
  "properties": {
    "schemaVersion": {
      "const": "reframe4s.motion-superiority.assets/v1"
    },
    "protocolSha256": {
      "$ref": "#/$defs/sha256"
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/asset"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset",
        "datasetVersion",
        "sourceUrl",
        "license",
        "redistribution",
        "sourceSubject",
        "sourceRun",
        "generatorRevision"
      ],
      "properties": {
        "dataset": {
          "type": "string",
          "minLength": 1
        },
        "datasetVersion": {
          "type": "string",
          "minLength": 1
        },
        "sourceUrl": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "redistribution": {
          "type": "string",
          "minLength": 1
        },
        "sourceSubject": {
          "type": "string",
          "minLength": 1
        },
        "sourceRun": {
          "type": "string",
          "minLength": 1
        },
        "generatorRevision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "scenario",
        "stratum",
        "input",
        "motionFreeTruth",
        "truthPoses",
        "mask",
        "landmarks",
        "provenance"
      ],
      "properties": {
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "scenario": {
          "type": "string",
          "minLength": 1
        },
        "stratum": {
          "enum": [
            "synthetic",
            "real_anatomy"
          ]
        },
        "input": {
          "$ref": "#/$defs/file"
        },
        "motionFreeTruth": {
          "$ref": "#/$defs/file"
        },
        "truthPoses": {
          "$ref": "#/$defs/file"
        },
        "mask": {
          "$ref": "#/$defs/file"
        },
        "landmarks": {
          "$ref": "#/$defs/file"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    }
  }
}
